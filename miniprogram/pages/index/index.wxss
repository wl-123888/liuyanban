.ct{padding:24px 20px}.hd{text-align:center;margin-bottom:24px;padding-top:16px}.ic{font-size:56px;margin-bottom:10px;display:block;text-align:center}.tl{font-size:26px;font-weight:700;color:var(--p);margin-bottom:4px}.sub{font-size:14px;color:var(--t2)}.clist{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}.citem{background:var(--c);border-radius:14px;padding:16px 20px;box-shadow:0 2px 8px rgba(0,0,0,.06);text-align:center;min-width:100px;font-size:16px;font-weight:500}.citem:active{transform:scale(.95);background:#EEF4FB}.cadd{background:none;border:2px dashed #ccc;box-shadow:none;color:var(--t2);font-size:14px}.emp{text-align:center;color:#ccc;font-size:14px;padding:24px 0}.note{text-align:center;margin-top:24px;font-size:12px;color:#bbb}
