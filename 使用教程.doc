<style>
@page { size: A4; margin: 2cm 2cm 2cm 2cm; }
body { font-family: "Microsoft YaHei","PingFang SC",sans-serif; font-size: 14px; color: #333; line-height: 2; }
h1 { font-size: 22px; color: #4A90D9; text-align: center; margin-bottom: 8px; }
h2 { font-size: 17px; color: #4A90D9; margin: 24px 0 10px; border-bottom: 2px solid #E8ECF1; padding-bottom: 5px; }
h3 { font-size: 15px; color: #555; margin: 16px 0 8px; }
p { margin: 5px 0; font-size: 14px; }
li { margin: 4px 0; font-size: 14px; }
code { background: #F0F4F8; padding: 1px 5px; font-size: 13px; word-break: break-all; }
table { border-collapse: collapse; width: 100%; margin: 10px 0; }
td { padding: 6px 10px; border: 1px solid #ddd; font-size: 13px; }
blockquote { background: #FFF8E1; border-left: 4px solid #FFC107; padding: 8px 14px; margin: 10px 0; font-size: 13px; }
.q { font-weight: bold; margin: 14px 0 4px; }
